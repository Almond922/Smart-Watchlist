datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  name            String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  watchlists      Watchlist[]
  changeDetections ChangeDetection[]

  @@index([email])
}

model Watchlist {
  id        String          @id @default(cuid())
  userId    String
  name      String          @default("My Watchlist")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WatchlistItem[]

  @@index([userId])
}

model WatchlistItem {
  id            String    @id @default(cuid())
  watchlistId   String
  symbol        String
  companyName   String
  addedAt       DateTime  @default(now())
  sortOrder     Int       @default(0)
  lastCheckedAt DateTime?
  lastSeenPrice Float?
  lastSeenVolume Float?

  watchlist     Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, symbol])
  @@index([symbol])
  @@index([watchlistId])
}

model MarketSnapshot {
  id            String   @id @default(cuid())
  symbol        String
  price         Float
  changePercent Float
  volume        Float
  high52Week    Float?
  low52Week     Float?
  timestamp     DateTime @default(now())
  dataSource    String   @default("mock")
  freshness     String   @default("LIVE") // LIVE, RECENT, DELAYED, STALE
  createdAt     DateTime @default(now())

  @@index([symbol, timestamp])
}

model MarketEvent {
  id          String   @id @default(cuid())
  symbol      String
  eventType   String   // earnings, news, filing, dividend, analyst
  title       String
  description String?
  timestamp   DateTime @default(now())
  source      String   @default("market-wire")
  externalId  String?

  @@index([symbol, timestamp])
}

model ChangeDetection {
  id             String    @id @default(cuid())
  userId         String
  symbol         String
  detectedAt     DateTime  @default(now())
  attentionScore Float
  attentionLevel String    // LOW, MEDIUM, HIGH, CRITICAL
  reasons        String    // JSON encoded structured reasons
  reviewedAt     DateTime?

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, detectedAt])
  @@index([userId, symbol])
}

